# =====================================================================
# Mendo Plant - variables de entorno (plantilla)
# ---------------------------------------------------------------------
#  Copiá este archivo como ".env" y completá los valores.
#  El archivo ".env" está en .gitignore: NUNCA se sube al repo.
#  Exportá las variables antes de arrancar (ej: set VAR=valor en Windows)
#  o usá el plugin dotenv de Maven / IntelliJ.
# =====================================================================

# --- Base de datos MySQL (XAMPP) ---
MYSQL_USER=root
MYSQL_PASSWORD=

# --- Envío de email (SMTP) para los códigos de verificación ---
# Si MAIL_HOST queda vacío, la app imprime el código en la consola.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Mendo Plant <no-responder@plant_finder.local>

# --- URL pública de la app (la usa Mercado Pago para back_urls/webhook) ---
URL_PUBLICA=http://localhost:8080

# --- Mercado Pago (Checkout Pro) ---
# Sin MP_ACCESS_TOKEN el checkout cae al flujo simulado (sin pago real).
MP_ACCESS_TOKEN=
MP_SANDBOX=true

# --- Envíos ---
ENVIO_TARIFA_PLANA=0
ENVIO_GRATIS_DESDE=90000

# --- Facturación ---
FACTURACION_PROVEEDOR=local
FACTURACION_PUNTO_VENTA=1
FACTURACION_LETRA=C
FACTURACION_CUIT=
FACTURACION_RAZON_SOCIAL=Mendo Plant
FACTURACION_DOMICILIO=Mendoza, Argentina
FACTURACION_CONDICION=Monotributista
